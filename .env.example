# Backend base URL (no trailing slash), e.g. https://my-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8080

# true = use the in-memory demo backend (no real backend required)
VITE_USE_MOCK=false

# Polling interval in milliseconds
VITE_POLLING_INTERVAL_MS=3000

# Timeout of each HTTP request in milliseconds
VITE_API_TIMEOUT_MS=8000
